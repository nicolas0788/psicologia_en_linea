---
// src/components/form/FormMessage.astro

/*
|--------------------------------------------------------------------------
| FormMessage
|--------------------------------------------------------------------------
|
| Componente reutilizable para mostrar los estados visuales de un formulario.
|
| Estados soportados:
|
|   .is-pending  -> petición en proceso
|   .is-success  -> operación finalizada correctamente
|   .is-error    -> operación finalizada con error
|
| El componente controla SU PROPIA VISIBILIDAD mediante el atributo `hidden`.
|
| IMPORTANTE:
|
| NO es necesario ocultar el contenedor padre con:
|
|   display: none;
|
| De hecho, si el padre permanece con `display: none`, el estado pending,
| success o error no podrá verse aunque FormManager quite `hidden`.
|
| El padre puede controlar:
|
| - width
| - margin
| - padding externo
| - posición
|
| Pero debe permanecer visible.
|
|--------------------------------------------------------------------------
| Uso básico
|--------------------------------------------------------------------------
|
| import FormMessage from "../form/FormMessage.astro";
|
| <FormMessage
|   id="contact-message"
|   class="contact-form-message"
| />
|
|--------------------------------------------------------------------------
| HTML generado
|--------------------------------------------------------------------------
|
| <p
|   id="contact-message"
|   class="form-message contact-form-message"
|   role="status"
|   aria-live="polite"
|   aria-atomic="true"
|   hidden
| ></p>
|
|--------------------------------------------------------------------------
| Integración con FormManager
|--------------------------------------------------------------------------
|
| const messageElement =
|   formManager.registerElement("#contact-message");
|
| El flujo recomendado es:
|
| 1. Limpiar mensaje anterior:
|
|   formManager.clearMessage(messageElement);
|
| 2. Mostrar pending:
|
|   formManager.startPending(
|     messageElement,
|     "Enviando consulta...",
|   );
|
| 3. Ejecutar petición:
|
|   const response = await formManager.sendFormData(
|     "/forms.php",
|     new FormData(formManager.form),
|   );
|
| 4. Reemplazar pending por success o error:
|
|   if (response.success) {
|     formManager.successMessage(
|       messageElement,
|       response.message,
|     );
|
|     return;
|   }
|
|   formManager.errorMessage(
|     messageElement,
|     response.message,
|   );
|
|--------------------------------------------------------------------------
| Ejemplo completo
|--------------------------------------------------------------------------
|
| const formManager = new FormManager("form-contact");
|
| const messageElement =
|   formManager.registerElement("#contact-message");
|
| formManager.form.addEventListener(
|   "submit",
|   async (event) => {
|     event.preventDefault();
|
|     formManager.clearMessage(messageElement);
|
|     formManager.startPending(
|       messageElement,
|       "Enviando consulta...",
|     );
|
|     const formData =
|       new FormData(formManager.form);
|
|     const response =
|       await formManager.sendFormData(
|         "/forms.php",
|         formData,
|       );
|
|     if (response.success) {
|       formManager.form.reset();
|
|       formManager.successMessage(
|         messageElement,
|         "Gracias por contactarte",
|       );
|
|       return;
|     }
|
|     formManager.errorMessage(
|       messageElement,
|       response.message,
|     );
|   },
| );
|
|--------------------------------------------------------------------------
| Funcionamiento esperado de FormManager
|--------------------------------------------------------------------------
|
| startPending():
|
|   element.classList.remove(
|     "is-success",
|     "is-error",
|   );
|
|   element.classList.add("is-pending");
|   element.setAttribute("aria-busy", "true");
|   element.textContent = "Enviando...";
|   element.hidden = false;
|
|
| successMessage():
|
|   element.classList.remove(
|     "is-pending",
|     "is-error",
|   );
|
|   element.classList.add("is-success");
|   element.removeAttribute("aria-busy");
|   element.hidden = false;
|
|
| errorMessage():
|
|   element.classList.remove(
|     "is-pending",
|     "is-success",
|   );
|
|   element.classList.add("is-error");
|   element.removeAttribute("aria-busy");
|   element.hidden = false;
|
|
| clearMessage():
|
|   element.classList.remove(
|     "is-pending",
|     "is-success",
|     "is-error",
|   );
|
|   element.removeAttribute("aria-busy");
|   element.textContent = "";
|   element.hidden = true;
|
|--------------------------------------------------------------------------
| Estados visuales
|--------------------------------------------------------------------------
|
| PENDING
|
|   .is-pending
|
| Muestra un spinner animado junto al mensaje:
|
|   "Enviando consulta..."
|
|
| SUCCESS
|
|   .is-success
|
| Muestra un icono ✓.
|
|
| ERROR
|
|   .is-error
|
| Muestra un icono !.
|
|--------------------------------------------------------------------------
| Estilos desde el padre
|--------------------------------------------------------------------------
|
| El padre NO debe ocultar el contenedor del FormMessage.
|
| CORRECTO:
|
| .contact-form-message-container {
|   width: 100%;
|   margin-top: 1rem;
| }
|
| :global(
|   .contact-form-message-container > .form-message
| ) {
|   width: 100%;
|   padding: 0.9rem 1rem;
|   border: 1px solid transparent;
|   border-left-width: 4px;
|   border-radius: 0.75rem;
|   font-size: 0.95rem;
|   font-weight: 700;
|   line-height: 1.45;
| }
|
|
| INCORRECTO:
|
| .contact-form-message-container {
|   display: none;
| }
|
| No debe utilizarse `:has()` para mostrar u ocultar el padre.
| FormMessage ya controla su propia visibilidad mediante `hidden`.
|
|--------------------------------------------------------------------------
*/

interface Props {
  id?: string;
  class?: string;
  ariaLive?: "polite" | "assertive";
}

const {
  id = "submit-messages",
  class: className,
  ariaLive = "polite",
} = Astro.props;
---

<p
  id={id}
  class:list={["form-message", className]}
  role="status"
  aria-live={ariaLive}
  aria-atomic="true"
  hidden
>
</p>

<style is:global>
  /*
  |--------------------------------------------------------------------------
  | FormMessage
  |--------------------------------------------------------------------------
  |
  | El propio componente controla su visibilidad.
  |
  | El componente padre puede definir dimensiones,
  | separación y tipografía.
  |
  */

  .form-message {
    /*
     * Pending
     */

    --form-message-pending-color: #4a4675;
    --form-message-pending-accent: #655dc1;
    --form-message-pending-background: #f3f2ff;
    --form-message-pending-border: rgb(101 93 193 / 30%);

    /*
     * Success
     */

    --form-message-success-color: #185b39;
    --form-message-success-accent: #25794e;
    --form-message-success-background: #eefaf3;
    --form-message-success-border: rgb(37 121 78 / 30%);

    /*
     * Error
     */

    --form-message-error-color: #7e1b2b;
    --form-message-error-accent: #b4233b;
    --form-message-error-background: #fff0f2;
    --form-message-error-border: rgb(180 35 59 / 30%);

    /*
     * Indicador
     */

    --form-message-icon-size: 1.35rem;
    --form-message-icon-color: #ffffff;

    box-sizing: border-box;
    max-width: 100%;

    align-items: center;
    gap: 0.75rem;

    overflow-wrap: anywhere;
  }

  /*
  |--------------------------------------------------------------------------
  | Visibilidad
  |--------------------------------------------------------------------------
  |
  | `hidden` es la fuente de verdad para determinar
  | si el mensaje debe mostrarse.
  |
  */

  .form-message[hidden] {
    display: none !important;
  }

  .form-message:not([hidden]).is-pending,
  .form-message:not([hidden]).is-success,
  .form-message:not([hidden]).is-error {
    display: flex;
  }

  /*
   * Si por algún motivo el elemento está visible pero no tiene
   * ningún estado reconocido, se mantiene oculto.
   */

  .form-message:not(.is-pending):not(.is-success):not(.is-error) {
    display: none;
  }

  /*
  |--------------------------------------------------------------------------
  | Indicador común
  |--------------------------------------------------------------------------
  */

  .form-message::before {
    width: var(--form-message-icon-size);
    height: var(--form-message-icon-size);

    flex: 0 0 var(--form-message-icon-size);

    display: inline-flex;
    align-items: center;
    justify-content: center;

    box-sizing: border-box;

    border-radius: 50%;

    color: var(--form-message-icon-color);

    font-size: calc(var(--form-message-icon-size) * 0.63);

    font-weight: 900;
    line-height: 1;
  }

  /*
  |--------------------------------------------------------------------------
  | Pending
  |--------------------------------------------------------------------------
  */

  .form-message.is-pending {
    border-color: var(--form-message-pending-border);

    border-left-color: var(--form-message-pending-accent);

    background: var(--form-message-pending-background);

    color: var(--form-message-pending-color);
  }

  .form-message.is-pending::before {
    content: "";

    border: 2px solid rgb(101 93 193 / 25%);

    border-top-color: var(--form-message-pending-accent);

    animation: form-message-spin 0.7s linear infinite;
  }

  /*
  |--------------------------------------------------------------------------
  | Success
  |--------------------------------------------------------------------------
  */

  .form-message.is-success {
    border-color: var(--form-message-success-border);

    border-left-color: var(--form-message-success-accent);

    background: var(--form-message-success-background);

    color: var(--form-message-success-color);
  }

  .form-message.is-success::before {
    content: "✓";

    background: var(--form-message-success-accent);
  }

  /*
  |--------------------------------------------------------------------------
  | Error
  |--------------------------------------------------------------------------
  */

  .form-message.is-error {
    border-color: var(--form-message-error-border);

    border-left-color: var(--form-message-error-accent);

    background: var(--form-message-error-background);

    color: var(--form-message-error-color);
  }

  .form-message.is-error::before {
    content: "!";

    background: var(--form-message-error-accent);
  }

  /*
  |--------------------------------------------------------------------------
  | Animación
  |--------------------------------------------------------------------------
  */

  @keyframes form-message-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /*
  |--------------------------------------------------------------------------
  | Accesibilidad
  |--------------------------------------------------------------------------
  */

  @media (prefers-reduced-motion: reduce) {
    .form-message.is-pending::before {
      animation-duration: 1.5s;
    }
  }
</style>
