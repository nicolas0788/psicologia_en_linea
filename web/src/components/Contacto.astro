---
// src/components/contacto/Contacto.astro

import ArcoSuperior from "./assets/ArcoSuperior.astro";
import FormMessage from "./assets/FormMessage.astro";
import HoneyPot from "./assets/HoneyPot.astro";
---

<section class="contact-section section-general">
  <ArcoSuperior />

  <div class="contact-container container-general">
    <aside class="contact-info">
      <div class="contact-title-row">
        <span aria-hidden="true"></span>

        <h1 class="titles-general">Contacto</h1>
      </div>

      <p class="description-general contact-subtitle">
        Estamos para acompañarte en el primer paso.
      </p>

      <div class="contact-list">
        <a
          class="contact-item"
          href="https://wa.me/5491149474689"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M20 11.5A8.5 8.5 0 0 1 7.4 19L3 20l1.2-4.2A8.5 8.5 0 1 1 20 11.5Z"
              ></path>

              <path
                d="M8.8 8.5c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .6.4l.7 1.6c.1.3.1.5-.1.7l-.4.5c-.1.2-.2.3 0 .6.3.6 1.2 1.8 2.6 2.5.3.2.5.1.7-.1l.7-.8c.2-.2.4-.2.7-.1l1.5.7c.3.1.5.3.4.6-.1.7-.7 1.6-1.4 1.8-.6.2-1.5.2-3-.4-2.6-1-4.3-3.6-4.4-3.7-.1-.2-1-1.4-1-2.6 0-1.2.6-1.8.8-2.1Z"
              ></path>
            </svg>
          </div>

          <div>
            <strong> WhatsApp </strong>

            <p>+54 9 11 4947-4689</p>

            <small> Escribinos por WhatsApp </small>
          </div>
        </a>

        <div class="contact-item">
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M12 21s7-5.2 7-12a7 7 0 0 0-14 0c0 6.8 7 12 7 12Z"
              ></path>

              <circle cx="12" cy="9" r="2.5"></circle>
            </svg>
          </div>

          <div>
            <strong> Ciudad de Buenos Aires, Argentina </strong>
          </div>
        </div>

        <a class="contact-item" href="mailto:contacto@psicologiaenlinea.ar">
          <div class="contact-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4z"></path>
              <path d="m4 7 8 6 8-6"></path>
            </svg>
          </div>

          <div>
            <strong> contacto@psicologiaenlinea.ar </strong>
          </div>
        </a>
      </div>
    </aside>

    <div class="contact-form-panel">
      <form id="form-contact" class="contact-form">
        <input type="hidden" name="formName" value="contact" />

        <h2 class="titles-general contact-form-title">
          Formulario de contacto
        </h2>

        <fieldset class="contact-tabs">
          <legend class="visually-hidden"> Tipo de consulta </legend>

          <label>
            <input
              type="radio"
              name="consultationType"
              value="consultante"
              checked
              required
            />

            <span> Soy Consultante </span>
          </label>

          <label>
            <input type="radio" name="consultationType" value="profesional" />

            <span> Soy Profesional </span>
          </label>
        </fieldset>

        <label class="field">
          <span class="visually-hidden"> Motivo de consulta </span>

          <input
            type="text"
            name="motivo"
            placeholder="Motivo de consulta"
            minlength="3"
            maxlength="80"
            required
          />
        </label>

        <label class="field">
          <span class="visually-hidden"> Nombre y apellido </span>

          <input
            type="text"
            name="name"
            placeholder="Nombre y apellido"
            autocomplete="name"
            required
          />
        </label>

        <label class="field">
          <span class="visually-hidden"> Correo electrónico </span>

          <input
            type="email"
            name="email"
            placeholder="Email"
            autocomplete="email"
            required
          />
        </label>

        <label class="field textarea-field">
          <span class="visually-hidden"> Mensaje </span>

          <textarea
            name="message"
            placeholder="Mensaje"
            minlength="10"
            maxlength="600"
            required></textarea>
        </label>

        <HoneyPot name="contact-form-web" />

        <button type="submit" class="contact-submit"> Enviar </button>

        <FormMessage id="contact-message" class="contact-form-message" />
      </form>
    </div>
  </div>
</section>

<script>
  import { FormManager } from "../scripts/form/FormManager";

  const formManager = new FormManager("form-contact");

  const messageElement = formManager.registerElement("#contact-message");

  formManager.form.addEventListener("submit", async (event) => {
    event.preventDefault();

    formManager.clearMessage(messageElement);

    formManager.startPending(messageElement, "Enviando consulta...");

    const formData = new FormData(formManager.form);

    const response = await formManager.sendFormData("/forms.php", formData);

    if (response.success) {
      formManager.form.reset();

      formManager.successMessage(messageElement, "Gracias por contactarte");

      return;
    }

    formManager.errorMessage(messageElement, response.message);
  });
</script>

<style>
  /*
    |--------------------------------------------------------------------------
    | Sección general
    |--------------------------------------------------------------------------
    */

  .contact-section {
    position: relative;
    overflow: hidden;
    background: #f8f1ef;
  }

  .contact-container {
    position: relative;
    z-index: 1;

    min-height: 600px;

    display: flex;
    align-items: stretch;

    gap: 0;

    margin-top: 3.5rem;

    overflow: hidden;

    border-radius: 1.5rem;
  }

  .contact-info,
  .contact-form-panel {
    min-width: 0;
    flex: 1 1 50%;
  }

  /*
    |--------------------------------------------------------------------------
    | Información de contacto
    |--------------------------------------------------------------------------
    */

  .contact-info {
    display: flex;
    flex-direction: column;
    justify-content: center;

    padding: clamp(2rem, 4vw, 3.5rem);

    background: #f8f1ef;
  }

  .contact-title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .contact-title-row > span {
    width: 3px;
    height: 3rem;

    flex-shrink: 0;

    border-radius: 999px;

    background: #f4bd68;
  }

  .contact-title-row .titles-general {
    margin: 0;
    color: #292064;
  }

  .contact-subtitle {
    margin-top: 0.6rem;
    margin-bottom: 0;

    color: #68619d;
  }

  .contact-list {
    width: 100%;
    margin-top: 1.25rem;
  }

  .contact-item {
    display: grid;

    grid-template-columns:
      46px
      minmax(0, 1fr);

    align-items: center;

    gap: 0.9rem;

    padding: 0.8rem 0;

    border-bottom: 1px solid rgba(41, 32, 100, 0.15);
  }

  .contact-item:last-child {
    border-bottom: none;
  }

  .contact-icon {
    width: 46px;
    height: 46px;

    display: grid;
    place-items: center;

    border-radius: 0.9rem;

    background: #ffe3a8;
  }

  .contact-icon svg {
    width: 23px;
    height: 23px;

    fill: none;

    stroke: #292064;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contact-item strong {
    display: block;

    color: #292064;

    font-size: 0.95rem;
    line-height: 1.3;

    overflow-wrap: anywhere;
  }

  .contact-item p,
  .contact-item small {
    margin: 0;

    color: #68619d;

    font-size: 0.9rem;
    line-height: 1.4;
  }

  /*
    |--------------------------------------------------------------------------
    | Panel del formulario
    |--------------------------------------------------------------------------
    */

  .contact-form-panel {
    display: flex;
    align-items: center;
    justify-content: center;

    padding: clamp(2rem, 4vw, 3.5rem);

    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(255, 255, 255, 0.08),
        transparent 30%
      ),
      linear-gradient(135deg, #4b4386, #292064);
  }

  .contact-form {
    width: min(100%, 560px);

    display: flex;
    flex-direction: column;
  }

  .contact-form-title {
    margin-top: 0;
    margin-bottom: 1.15rem;

    color: #ffffff;

    text-align: center;
  }

  /*
    |--------------------------------------------------------------------------
    | Selector del tipo de consulta
    |--------------------------------------------------------------------------
    */

  .contact-tabs {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    margin: 0 0 0.8rem;
    padding: 0;

    overflow: hidden;

    border: 0;
    border-radius: 0.75rem;

    background: rgba(255, 255, 255, 0.92);
  }

  .contact-tabs label {
    position: relative;
    cursor: pointer;
  }

  .contact-tabs input {
    position: absolute;

    opacity: 0;
    pointer-events: none;
  }

  .contact-tabs span {
    min-height: 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0.65rem 0.8rem;

    color: #292064;

    cursor: pointer;

    text-align: center;

    font-size: 1rem;
    font-weight: 700;

    transition:
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .contact-tabs input:checked + span {
    background: linear-gradient(135deg, #ffe8ad, #ffd57d);
  }

  .contact-tabs input:focus-visible + span {
    position: relative;
    z-index: 1;

    box-shadow: inset 0 0 0 3px #f4bd68;
  }

  /*
    |--------------------------------------------------------------------------
    | Campos
    |--------------------------------------------------------------------------
    */

  .field {
    width: 100%;
    height: 58px;

    display: flex;
    align-items: center;

    margin-bottom: 0.8rem;
    padding: 0 1rem;

    border: 2px solid transparent;
    border-radius: 0.75rem;

    background: rgba(255, 255, 255, 0.95);

    box-sizing: border-box;

    transition:
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .field:focus-within {
    border-color: #f4bd68;

    box-shadow: 0 0 0 3px rgba(244, 189, 104, 0.2);
  }

  .field input,
  .field textarea {
    width: 100%;

    margin: 0;
    padding: 0;

    border: 0;
    outline: 0;

    background: transparent;

    color: #292064;

    font-family: inherit;
    font-size: 0.95rem;

    box-sizing: border-box;
  }

  .field input {
    height: 100%;
    line-height: normal;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: #7a72aa;
    opacity: 1;
  }

  /*
    |--------------------------------------------------------------------------
    | Textarea
    |--------------------------------------------------------------------------
    */

  .textarea-field {
    height: 105px;

    align-items: flex-start;

    padding-top: 0.9rem;
    padding-bottom: 0.8rem;
  }

  .textarea-field textarea {
    height: 100%;
    min-height: 0;

    line-height: 1.45;

    resize: none;
  }

  /*
    |--------------------------------------------------------------------------
    | Botón
    |--------------------------------------------------------------------------
    */

  .contact-submit {
    min-width: 160px;
    height: 54px;

    align-self: flex-start;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-top: 0.1rem;

    padding: 0 1.5rem;

    border: 0;
    border-radius: 0.75rem;

    background: linear-gradient(135deg, #ffe8ad, #ffd57d);

    color: #292064;

    cursor: pointer;

    font-family: inherit;

    font-size: 0.9rem;
    font-weight: 900;

    letter-spacing: 0.1em;
    text-transform: uppercase;

    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      opacity 180ms ease;
  }

  .contact-submit:hover {
    transform: translateY(-2px);

    box-shadow: 0 8px 20px rgba(20, 14, 69, 0.25);
  }

  .contact-submit:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  .contact-submit:disabled {
    cursor: wait;
    opacity: 0.65;
    transform: none;
  }

  /*
    |--------------------------------------------------------------------------
    | FormMessage
    |--------------------------------------------------------------------------
    |
    | FormMessage controla por sí mismo:
    |
    | - hidden
    | - pending
    | - success
    | - error
    | - icono / spinner
    |
    | Este componente solamente adapta su geometría y presentación
    | para integrarlo dentro del formulario.
    |
    */

  :global(.contact-form > .contact-form-message) {
    width: 100%;

    margin: 1rem 0 0;

    padding: 0.9rem 1rem;

    border: 1px solid transparent;

    border-left-width: 4px;

    border-radius: 0.75rem;

    box-sizing: border-box;

    font-family: inherit;

    font-size: 0.95rem;

    font-weight: 700;

    line-height: 1.45;
  }

  /*
     * Cuando el mensaje está oculto no ocupa espacio.
     */

  :global(.contact-form > .contact-form-message[hidden]) {
    display: none !important;
  }

  /*
     * Ajuste específico para pending.
     *
     * El FormMessage define colores y spinner.
     * Aquí solamente adaptamos ligeramente el recuadro
     * al fondo oscuro del formulario.
     */

  :global(.contact-form > .contact-form-message.is-pending) {
    box-shadow: 0 4px 14px rgba(20, 14, 69, 0.12);
  }

  /*
     * Success.
     */

  :global(.contact-form > .contact-form-message.is-success) {
    box-shadow: 0 4px 14px rgba(20, 14, 69, 0.12);
  }

  /*
     * Error.
     */

  :global(.contact-form > .contact-form-message.is-error) {
    box-shadow: 0 4px 14px rgba(20, 14, 69, 0.12);
  }

  /*
    |--------------------------------------------------------------------------
    | Accesibilidad
    |--------------------------------------------------------------------------
    */

  .visually-hidden {
    position: absolute;

    width: 1px;
    height: 1px;

    padding: 0;
    margin: -1px;

    overflow: hidden;

    border: 0;

    white-space: nowrap;

    clip-path: inset(50%);
  }

  /*
    |--------------------------------------------------------------------------
    | Responsive
    |--------------------------------------------------------------------------
    */

  @media (max-width: 900px) {
    .contact-container {
      min-height: auto;

      flex-direction: column;
    }

    .contact-info,
    .contact-form-panel {
      width: 100%;
      flex: initial;
    }

    .contact-info {
      text-align: center;
    }

    .contact-title-row {
      justify-content: center;
    }

    .contact-list {
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .contact-container {
      margin-top: 3rem;

      border-radius: 1.25rem;
    }

    .contact-info,
    .contact-form-panel {
      padding: 2rem 1.1rem;
    }

    .contact-title-row {
      gap: 0.8rem;
    }

    .contact-title-row > span {
      height: 2.5rem;
    }

    .contact-tabs {
      grid-template-columns: 1fr;
    }

    .contact-tabs span {
      min-height: 50px;

      font-size: 0.95rem;
    }

    .contact-item {
      grid-template-columns:
        42px
        minmax(0, 1fr);

      gap: 0.8rem;

      padding: 0.7rem 0;
    }

    .contact-icon {
      width: 42px;
      height: 42px;
    }

    .contact-icon svg {
      width: 21px;
      height: 21px;
    }

    .contact-submit {
      width: 100%;
      align-self: stretch;
    }

    :global(.contact-form > .contact-form-message) {
      margin-top: 0.85rem;

      padding: 0.85rem 0.9rem;

      font-size: 0.9rem;
    }
  }
</style>
