---
import { Image } from "astro:assets";

import individualIcon from "../assets/img/precios/ind.png";
import parejaIcon from "../assets/img/precios/par.png";

const mes = "junio";
const anio = "2026";

const precioIndividualPresencial = "25.000";
const precioIndividualVirtual = "25.000";

const precioParejaPresencial = "35.000";
const precioParejaVirtual = "35.000";

const vigenciaDias = 60;
---

<section class="price-section">
  <article class="price-card">
    <header class="price-header">
      <p class="price-date">
        Honorarios vigentes - {mes}
        {anio}
      </p>

      <h2 class="price-title">Valor por sesión</h2>
    </header>

    <div class="price-list">
      <article class="price-item">
        <div class="price-icon">
          <Image
            src={individualIcon}
            alt="Ícono de terapia individual"
            width={48}
            height={48}
            loading="eager"
            class="price-icon-img"
          />
        </div>

        <div class="price-options">
          <div class="price-option">
            <strong>Individual presencial</strong>
            <span>ARS ${precioIndividualPresencial}</span>
          </div>

          <div class="price-option">
            <strong>Individual virtual</strong>
            <span>ARS ${precioIndividualVirtual}</span>
          </div>
        </div>
      </article>

      <article class="price-item">
        <div class="price-icon">
          <Image
            src={parejaIcon}
            alt="Ícono de terapia de pareja"
            width={48}
            height={48}
            loading="eager"
            class="price-icon-img"
          />
        </div>

        <div class="price-options">
          <div class="price-option">
            <strong>Pareja presencial</strong>
            <span>ARS ${precioParejaPresencial}</span>
          </div>

          <div class="price-option">
            <strong>Pareja virtual</strong>
            <span>ARS ${precioParejaVirtual}</span>
          </div>
        </div>
      </article>
    </div>

    <div class="price-note">
      <span class="price-note-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M20 13 13 20 4 11V4h7l9 9Z"></path>
          <circle cx="8.5" cy="8.5" r="1.2"></circle>
        </svg>
      </span>

      <p>
        Iniciá tus sesiones y mantené este valor por
        <strong> {vigenciaDias} días</strong>
      </p>
    </div>
  </article>
</section>

<style>
  .price-section {
    width: 100%;
    min-width: 0;
    padding: 1.5rem 1rem;
    display: flex;
    justify-content: center;
  }

  .price-card {
    width: min(100%, 620px);
    padding: clamp(1.1rem, 3vw, 1.7rem);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, #fbf8ff 0%, #f3edf8 100%);
    color: #25145f;
  }

  .price-header {
    text-align: center;
  }

  .price-date {
    margin: 0 0 0.45rem;
    font-size: clamp(0.85rem, 2vw, 1.05rem);
    font-weight: 700;
    color: #33226d;
  }

  .price-title {
    margin: 0;
    font-size: clamp(1.9rem, 5vw, 3rem);
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .price-list {
    margin-top: 1.2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .price-item {
    min-width: 0;
    padding: 1.2rem 1rem;
    border-radius: 1.1rem;
    background: rgba(238, 230, 246, 0.75);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0.85rem;

    text-align: center;
  }

  .price-icon {
    width: 3rem;
    height: 3rem;
    flex: 0 0 3rem;

    display: flex;
    align-items: center;
    justify-content: center;

    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    overflow: visible;
  }

  .price-icon-img {
    width: 2.75rem;
    height: 2.75rem;
    max-width: 100%;

    display: block;
    object-fit: contain;

    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .price-options {
    width: 100%;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .price-option {
    width: 100%;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .price-option strong {
    font-size: clamp(0.85rem, 2vw, 1rem);
    font-weight: 900;
    line-height: 1.2;
    color: #28155f;
  }

  .price-option span {
    font-size: clamp(1rem, 2.4vw, 1.25rem);
    line-height: 1.1;
    color: #25145f;
  }

  .price-note {
    margin-top: 0.9rem;
    padding: 0.65rem 0.9rem;
    border-radius: 999px;
    background: #e9e0f2;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;

    text-align: center;
  }

  .price-note p {
    margin: 0;
    font-size: clamp(0.78rem, 1.8vw, 0.95rem);
    font-weight: 700;
    color: #31206d;
  }

  .price-note-icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
  }

  .price-note-icon svg {
    width: 1.15rem;
    height: 1.15rem;
    stroke: #2b176b;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 600px) {
    .price-list {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .price-item {
      width: 100%;
      flex-direction: column;
      align-items: center;
      padding: 1rem;
    }

    .price-icon {
      width: 2.75rem;
      height: 2.75rem;
      flex-basis: 2.75rem;
    }

    .price-icon-img {
      width: 2.5rem;
      height: 2.5rem;
    }

    .price-options {
      flex-direction: column;
    }

    .price-option {
      flex-direction: column;
      text-align: center;
    }

    .price-note {
      border-radius: 1rem;
    }
  }
</style>
